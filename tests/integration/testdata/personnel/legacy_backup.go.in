//go:build integration

package bootstrap_test

import (
	access "chnhcm.local/chnhcm/internal/contexts/access/public"
	"chnhcm.local/chnhcm/internal/foundation"
	"encoding/json"
	"os"
	"os/exec"
	"testing"
)

func TestBackupBeforePersonnel(t *testing.T) {
	h := staffingSetup307(t)
	f := h.f
	must(t, f.runtime.InitializeCountryCatalog(f.ctx, access.LoginInput{Login: "admin", Password: f.password}))
	locations := location204{t, f, h.b, map[string]string{"MO": geoCountry203(t, f, "MO")}}
	location := locations.create("LOC-T01", "MO", "", "2026-01-01")
	bu := h.b.call("POST", "/api/v1/business-units", createBody("BU-T01", "2026-01-01"), foundation.NewID(), 201)["buId"].(string)
	dep := h.b.call("POST", "/api/v1/departments", departmentCreateBody("DEP-T01", bu), foundation.NewID(), 201)["departmentId"]
	family := h.create("jobfamily", "FT01", "")
	grade := h.create("grade", "GT01", "")["id"].(string)
	job := create310(h, "job", "JT01", []string{grade}, family["id"].(string))
	pos := h.b.call("POST", "/api/v1/positions", map[string]any{"code": "PT01", "name": "迁移样本岗位", "effectiveDate": "2027-01-01", "operationType": "CREATE", "operationReason": "NEW_POSITION", "departmentId": dep, "locationId": location["id"], "jobId": job["id"], "gradeId": grade}, foundation.NewID(), 201)["objectId"].(string)
	if os.Getenv("CHNHCM_BACKUP_POSITION_QUOTA") == "1" {
		path := "/api/v1/staffing-quotas/" + pos
		save := func(body map[string]any) map[string]any {
			return h.b.call("POST", path, body, foundation.NewID(), 200)
		}
		edit := func(day, action string) map[string]any {
			detail := h.b.call("GET", path+"?businessAt="+day, nil, "", 200)
			selected := detail["selected"].(map[string]any)
			return map[string]any{"action": action, "expectedSourceVersion": detail["sourceVersion"],
				"recordId": selected["recordId"], "expectedRecordRevision": selected["revision"], "reason": "核对原件"}
		}
		save(map[string]any{"action": "SET", "effectiveDate": "2027-04-01", "quantity": 2, "reason": "首次核编"})
		correction := edit("2027-04-01", "CORRECT")
		correction["effectiveDate"], correction["quantity"] = "2027-04-01", 3
		corrected := save(correction)
		save(map[string]any{"action": "SET", "effectiveDate": "2027-05-01", "quantity": 4, "reason": "临时增编", "expectedSourceVersion": corrected["sourceVersion"]})
		save(edit("2027-05-01", "DELETE"))
	}
	dir := os.Getenv("PERSONNEL_BACKUP_DIR")
	dump, e := os.OpenFile(dir+"/before.dump", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
	must(t, e)
	cmd := exec.Command("docker", "exec", f.container.GetContainerID(), "pg_dump", "-U", "postgres", "-d", "chnhcm", "-Fc")
	cmd.Stdout = dump
	must(t, cmd.Run())
	must(t, dump.Close())
	raw, _ := json.Marshal(map[string]string{"instance": f.instance, "password": f.password, "bu": bu, "position": pos})
	must(t, os.WriteFile(dir+"/fixture.json", raw, 0600))
}
