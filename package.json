{
  "name": "chnhcm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @chnhcm/web dev",
    "build": "corepack pnpm --filter @chnhcm/web build",
    "typecheck": "corepack pnpm --filter @chnhcm/web typecheck",
    "check:docs": "python3 -B scripts/check-repository.py",
    "test:smoke": "playwright test --config tests/e2e/playwright.config.ts",
    "generate:api": "openapi-typescript api/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "verify:mui-source": "node scripts/mui-source.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "25.2.3",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0"
  }
}
